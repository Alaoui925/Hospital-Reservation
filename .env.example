# Base URL of the real backend API.
# Leave empty to run the built-in mock API (localStorage backed) used for the demo.
VITE_API_URL=

# Application metadata
VITE_APP_NAME=MediCare Hospital
VITE_HOSPITAL_PHONE=+1 (555) 010-2000
VITE_HOSPITAL_EMAIL=contact@medicare-hospital.test

# When true the mock service layer adds a small artificial latency so loading
# states / spinners are visible while developing.
VITE_USE_MOCK_API=true
VITE_MOCK_LATENCY_MS=350
